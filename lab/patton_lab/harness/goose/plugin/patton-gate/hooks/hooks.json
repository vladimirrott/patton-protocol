{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(shell|write|edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh /patton/lab/patton_lab/harness/shim/patton-hook.sh goose",
            "timeout": 60,
            "on_failure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /patton/lab/patton_lab/harness/shim/patton-hook.sh goose stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
