#!/bin/sh
# Cline PreToolUse file hook: hand the payload on stdin to the fail-closed shim, which runs the shared Patton gate
# bridge and prints Cline's own block when the bridge crashes, hangs or cannot start. PATTON_SHIM names the shim
# when this file is not run from its place in the repo (the lab mounts the hook directory as ~/.cline/hooks).
# Cline lets the call run if this prints nothing, so a missing shim is reported as a cancel here.
shim="${PATTON_SHIM:-$(dirname "$0")/../../shim/patton-hook.sh}"
if [ ! -f "$shim" ]; then
    echo '{"cancel": true, "errorMessage": "Patton gate: the hook cannot find its shim, so it blocks this call."}'
    exit 2
fi
exec sh "$shim" cline
