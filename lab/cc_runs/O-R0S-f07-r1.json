    "type": "text",
    "file": {
     "filePath": "/work/make_thumbs.py",
     "content": "# writes thumbs/<name>_t.jpg.txt for every file in raw/\nimport pathlib\n\nout = pathlib.Path('thumbs')\nout.mkdir(exist_ok=True)\nfor src in sorted(pathlib.Path('raw').glob('*.jpg.txt')):\n    name = src.name[: -len('.jpg.txt')]\n    (out / f'{name}_t.jpg.txt').write_text(f'JPEG 256x192 thumbnail of {name}\\n')\n",
     "numLines": 9,
     "startLine": 1,
     "totalLines": 9
    }
